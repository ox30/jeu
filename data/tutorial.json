{
  "note": "Les leçons du tutoriel (I10) : chacune se joue sur son petit scénario (data/scenarios/lecon-*.json, écrit comme un scénario existant avec des changements) et suit ses étapes dans l'ordre. Une étape dit ce qu'elle fait en entrant (pause ou play, speed et keepSpeed, view, select, unitTab : l'onglet de la fiche) et à quoi elle se termine (done) ; « manual » lui donne un bouton pour passer à la suite ; « do » liste les ordres de l'instructeur (order), chacun donné une fois quand sa condition (when) est vraie, et « mark » retient l'heure. « times » et « gaps » remplissent le texte avec des heures de la leçon et des écarts en minutes. Les textes sont dans data/i18n/fr.json (tutorial.lessons.<leçon>.name, .summary et .steps.<étape>.title et .text). Conditions et ordres connus : src/ui/tutorial.js. « settings » : les réglages de la partie de la leçon, par-dessus le préréglage Standard.",
  "lessons": [
    {
      "id": "intercept",
      "scenario": "lecon-intercepter",
      "minutes": [
        3,
        5
      ],
      "settings": {
        "fatigue": "off",
        "detection": "approximate",
        "interceptAid": "track",
        "orders": "draw",
        "fuel": "simple",
        "falseAlarms": false,
        "questions": false
      },
      "steps": [
        {
          "id": "welcome",
          "manual": true,
          "pause": true,
          "view": "england"
        },
        {
          "id": "demo",
          "play": true,
          "speed": 60,
          "keepSpeed": true,
          "do": [
            {
              "when": {
                "contactNear": {
                  "raid": "d01",
                  "site": "airfield:hawkinge",
                  "km": 30
                }
              },
              "mark": "ordered",
              "order": {
                "scramble": "32",
                "toSite": "airfield:hawkinge",
                "altitudeFt": 14000
              }
            }
          ],
          "done": {
            "seen": [
              "siteHit"
            ]
          },
          "handsOff": true
        },
        {
          "id": "why",
          "manual": true,
          "pause": true,
          "do": [
            {
              "order": {
                "home": "32"
              }
            }
          ],
          "times": {
            "seen": {
              "event": "raidDetected"
            },
            "ordered": {
              "mark": "ordered"
            },
            "bombed": {
              "event": "siteHit"
            }
          },
          "gaps": {
            "waited": [
              "seen",
              "ordered"
            ],
            "left": [
              "ordered",
              "bombed"
            ]
          },
          "handsOff": true
        },
        {
          "id": "yourTurn",
          "manual": true,
          "pause": true,
          "select": {
            "kind": "squadron",
            "id": "111"
          },
          "unitTab": {
            "squadron": "cmd"
          },
          "view": "england"
        },
        {
          "id": "watch",
          "play": true,
          "speed": 10,
          "do": [
            {
              "order": {
                "releaseRaid": "d02",
                "inS": 120
              }
            }
          ],
          "done": {
            "count": {
              "type": "raidDetected",
              "n": 2
            }
          },
          "wait": true
        },
        {
          "id": "scramble",
          "done": {
            "airborne": [
              "111"
            ]
          },
          "view": "england"
        },
        {
          "id": "altitude",
          "done": {
            "any": [
              {
                "seenSince": [
                  "tallyHo",
                  "combatRound"
                ]
              },
              {
                "raidReported": "d02"
              }
            ]
          }
        },
        {
          "id": "combat",
          "done": {
            "raidReported": "d02"
          },
          "speed": 60,
          "keepSpeed": true,
          "play": true,
          "wait": true
        },
        {
          "id": "reports",
          "manual": true,
          "pause": true,
          "done": {
            "flag": "reportsOpened"
          }
        },
        {
          "id": "end",
          "manual": true,
          "last": true
        }
      ]
    },
    {
